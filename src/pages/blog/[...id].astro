---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { fmtDate } from '../../utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article class="prose">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{fmtDate(post.data.date)}</time>
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>
    <Content />
    <div class="post-footer"><a href="/blog/">← 返回文章列表</a></div>
  </article>
</Base>
