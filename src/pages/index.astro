---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { AUTHOR } from '../config';
import { fmtDate } from '../utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
const works = (await getCollection('works'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<Base>
  <section class="hero">
    <h1>你好,我是 {AUTHOR}。</h1>
    <p class="bio">写代码也写故事。这里存放我的文章、作品,以及正在折腾的东西。</p>
    <p class="hero-links"><a href="/about/">关于我 →</a></p>
  </section>

  <section class="section">
    <h2 class="section-title">最新文章<a class="more" href="/blog/">全部文章 →</a></h2>
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <a class="post-row" href={`/blog/${p.id}/`}>
            <time datetime={p.data.date.toISOString().slice(0, 10)}>{fmtDate(p.data.date)}</time>
            <span class="t">{p.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2 class="section-title">作品与项目<a class="more" href="/works/">全部作品 →</a></h2>
    <div class="card-grid">
      {works.map((w) => (
        <a class="card" href={w.data.link ?? `/works/${w.id}/`}>
          <span class="cat">{w.data.category}</span>
          <h3>{w.data.title}</h3>
          <p>{w.data.summary}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
